# Winnow optional keys. Copy to .env and fill in. Placeholders below are
# treated as UNSET, so the engine stays on keyless paths until you add real ones.

# Reddit OAuth (free "script" app at https://www.reddit.com/prefs/apps).
# Unlocks real upvote/comment scores + account-age/karma authenticity signals.
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=winnow/0.1 by u/your_username

# X / Twitter search (browser cookies from a logged-in x.com session).
AUTH_TOKEN=your_x_auth_token_cookie
CT0=your_x_ct0_cookie

# Pantip (Thailand) keyword search API — the Basic token from pantip.com's
# frontend (ptauthorize header). Without it, Pantip falls back to keyless RSS.
PANTIP_AUTH=your_pantip_basic_token
